// Compiled by both backends; the runner diffs their output.
fn power(base: int, exponent: int) -> int {
    let result = 1;
    for _i in 0..exponent {
        result *= base;
    }
    return result;
}

fn sum_to(n: int) -> int {
    let total = 0;
    let i = 1;
    while i <= n {
        total += i;
        i += 1;
    }
    return total;
}

println("power:", power(2, 20), power(3, 5), power(7, 0));
println("sums:", sum_to(100), sum_to(1000));
println("mixed:", (1 << 20) - 1, -100 / 7, -100 % 7, ~0 ^ 255);
println("logic:", true && false, false || true, !(1 > 2));
println("compare:", 1 < 2, 2 <= 2, 3 > 4, 4 >= 4, 5 == 5, 5 != 5);
println("nested:", min(max(3, 7), abs(-9)));
exit(7);
