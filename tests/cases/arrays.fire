//= [1, 2, 3] 3
//= [0, 1, 2, 3, 4] 5
//= 2 4 [0, 1, 3]
//= [2, 3, 4]
//= [[1, 2], [3, 4]] 3
//= [1, 2, 3] [1, 2, 3] true
//= true false
let xs = [1, 2, 3];
println(xs, len(xs));

insert(xs, 0, 0);
push(xs, 4);
println(xs, len(xs));
println(remove(xs, 2), pop(xs), xs);
println(slice([1, 2, 3, 4, 5], 1, 4));

let grid: [[int]] = [[1, 2], [3, 4]];
println(grid, grid[1][0]);

fn append(target: [int]) { push(target, 3); }
let a = [1, 2];
let b = a;
append(a);
println(a, b, a == b);
println([1, 2] == [1, 2], [1, 2] == [2, 1]);
